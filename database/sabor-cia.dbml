// ============================================================
// Sabor & Cia Bistro — Cardapio digital com disponibilidade por filial
// Modelo logico em DBML (dbdiagram.io), espelho de modelo_fisico_mysql.sql.
// A fonte de verdade e o script SQL; a Figura 6 do relatorio vem de
// diagramas/06_logico.puml. Para visualizar: https://dbdiagram.io (Import).
// ============================================================

Table filial {
  id_filial int [pk, increment]
  nome varchar(80) [not null]
  endereco varchar(150) [not null]
  bairro varchar(60) [not null]
  url_qrcode varchar(255) [not null, unique]
}

// Administrador e gerente na mesma tabela; gerente sempre tem filial (CHECK)
Table usuario {
  id_usuario int [pk, increment]
  nome varchar(100) [not null]
  email varchar(120) [not null, unique]
  senha_hash char(60) [not null, note: 'RNF04: hash bcrypt']
  perfil enum_perfil [not null]
  id_filial int [null]
}

Enum enum_perfil {
  ADMIN
  GERENTE
}

// RF10: maquininha identificada por token (SHA-256)
Table dispositivo {
  id_dispositivo int [pk, increment]
  id_filial int [not null]
  descricao varchar(60) [not null]
  token_hash char(64) [not null, unique]
  ativo boolean [not null, default: true]
}

Table categoria {
  id_categoria int [pk, increment]
  nome_pt varchar(60) [not null, unique]
  nome_en varchar(60) [not null]
  ordem_exibicao int [not null]
}

Table produto {
  id_produto int [pk, increment]
  id_categoria int [not null]
  nome_pt varchar(100) [not null]
  nome_en varchar(100) [not null]
  descricao_pt text
  descricao_en text
  ingredientes_pt text
  ingredientes_en text
  preco decimal(10,2) [not null, note: 'CHECK preco > 0']
  url_foto varchar(255)
}

Table alergeno {
  id_alergeno int [pk, increment]
  nome_pt varchar(50) [not null, unique]
  nome_en varchar(50) [not null]
}

Table produto_alergeno {
  id_produto int [not null]
  id_alergeno int [not null]
  indexes {
    (id_produto, id_alergeno) [pk]
  }
}

// prato x vinho (triggers garantem a categoria "Vinhos")
Table harmonizacao {
  id_prato int [not null]
  id_vinho int [not null]
  indexes {
    (id_prato, id_vinho) [pk]
  }
}

Table disponibilidade {
  id_produto int [not null]
  id_filial int [not null]
  ativo boolean [not null, default: true]
  atualizado_em datetime [not null]
  indexes {
    (id_produto, id_filial) [pk]
    (id_filial, ativo)
  }
}

// RF11: historico somente-anexacao
Table historico_disponibilidade {
  id_historico bigint [pk, increment]
  id_produto int [not null]
  id_filial int [not null]
  id_usuario int [not null]
  acao enum_acao [not null]
  data_hora datetime [not null]
  indexes {
    (id_filial, data_hora)
  }
}

Enum enum_acao {
  ATIVAR
  DESATIVAR
}

// Caixa de saida da replicacao para o MongoDB (secao 5.4), preenchida
// pelo trigger trg_historico_pendente na mesma transacao do evento
Table replicacao_pendente {
  id_historico bigint [pk]
  criado_em datetime [not null]
}

Ref: usuario.id_filial > filial.id_filial
Ref: dispositivo.id_filial > filial.id_filial
Ref: produto.id_categoria > categoria.id_categoria
Ref: produto_alergeno.id_produto > produto.id_produto [delete: cascade]
Ref: produto_alergeno.id_alergeno > alergeno.id_alergeno
Ref: harmonizacao.id_prato > produto.id_produto [delete: cascade]
Ref: harmonizacao.id_vinho > produto.id_produto [delete: cascade]
Ref: disponibilidade.id_produto > produto.id_produto [delete: cascade]
Ref: disponibilidade.id_filial > filial.id_filial [delete: cascade]
Ref: historico_disponibilidade.id_produto > produto.id_produto
Ref: historico_disponibilidade.id_filial > filial.id_filial
Ref: historico_disponibilidade.id_usuario > usuario.id_usuario
Ref: replicacao_pendente.id_historico - historico_disponibilidade.id_historico
