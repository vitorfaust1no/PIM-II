SELECT f.nome, COALESCE(SUM(d.ativo = FALSE), 0) AS itens_indisponiveis
FROM filial f
LEFT JOIN disponibilidade d ON d.id_filial = f.id_filial
GROUP BY f.id_filial, f.nome
ORDER BY f.id_filial
