UPDATE disponibilidade d
JOIN usuario u ON u.id_usuario = @usuario AND u.perfil = 'GERENTE'
SET d.ativo = FALSE
WHERE d.id_produto = @produto AND d.id_filial = u.id_filial AND d.ativo = TRUE
--------------

